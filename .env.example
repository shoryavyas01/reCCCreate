# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public HTTPS origin; localhost/invalid values use the known live domain.
NEXT_PUBLIC_SITE_URL=https://re-cc-create.vercel.app

# Existing Google Apps Script version 3+ serves Contact, Phool Mitra and Orders.
# Server-only values; include Production in Vercel and redeploy after changing.
PHOOL_MITRA_SCRIPT_URL=
PHOOL_MITRA_SECRET=
