# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web3Forms access key for the shop order form (web3forms.com).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Public address of the site, used for the QR codes on packs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phool Mitra sign-ups -> Google Sheet (server-only: no NEXT_PUBLIC_ prefix, never shown to visitors)
# The Apps Script web app URL, ending in /exec
PHOOL_MITRA_SCRIPT_URL=
# Any long random string; must match SHARED_SECRET in the Apps Script's script properties
PHOOL_MITRA_SECRET=
