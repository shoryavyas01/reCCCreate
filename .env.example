# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web3Forms access key (web3forms.com). Create it with the email that should receive messages.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Public address of the site, used for the QR codes on packs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
